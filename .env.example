# Primary account. This is the account that earns the badge.
# Classic token with `public_repo`, or a fine-grained token scoped to the
# target repository with Contents, Pull requests, and Discussions set to
# read and write.
GITHUB_TOKEN=your_github_token_here

# Target repository as owner/name. Leave unset to use the `origin` remote
# of this directory.
GITHUB_REPO=owner/repository

# Second account token. Galaxy Brain only. This account asks the question
# and marks the primary account's reply as the accepted answer, so the
# primary account is the one that earns the badge.
SECONDARY_GITHUB_TOKEN=second_account_github_token_here

# Second account login. Pair Extraordinaire only. The co-author email is
# derived from it through the API, because a mistyped address produces a
# commit that looks co-authored and counts for nothing.
COAUTHOR_USERNAME=second_account_login

# Seconds to wait between GitHub write requests. GitHub allows about 500
# content-generating requests per hour, and one pull request costs five of
# them, so 8 seconds sits just under the ceiling.
REQUEST_DELAY=8.0
